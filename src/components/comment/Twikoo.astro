---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const { path } = Astro.props;
const envId = commentConfig.twikoo?.envId ?? "";
const lang = commentConfig.twikoo?.lang;
---

<div
	id="tcomment"
	data-twikoo-root
	data-env-id={envId}
	data-lang={lang}
	data-path={path}
></div>
