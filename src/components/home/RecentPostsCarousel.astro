---
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { getFileDirFromPath, getPostUrl } from "@utils/url-utils";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const posts = Astro.props.posts.slice(0, 5);
const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(date);
---

{
	posts.length > 0 && (
		<recent-post-carousel class="recent-posts-card onload-animation" style="--i: 5">
			<div class="recent-posts-copy">
				<div class="recent-posts-kicker">
					<span>RECENT UPDATES</span>
					<i aria-hidden="true"></i>
				</div>
				<h2>刚刚更新的文章</h2>
				<p>五篇新记录，每 5 秒带你翻开下一页。</p>

				<div class="recent-posts-controls" aria-label="选择最近更新文章">
					{posts.map((post, index) => (
						<button
							type="button"
							data-carousel-index={index}
							aria-label={`查看第 ${index + 1} 篇：${post.data.title}`}
							aria-current={index === 0 ? "true" : undefined}
						>
							<span>{String(index + 1).padStart(2, "0")}</span>
						</button>
					))}
				</div>
			</div>

			<div class="recent-posts-stage">
				{posts.map((post, index) => (
					<a
						href={getPostUrl(post)}
						class:list={["recent-post-slide", { "is-active": index === 0 }]}
						data-carousel-slide={index}
						aria-hidden={index === 0 ? "false" : "true"}
					>
						<div class="recent-post-cover">
							{post.data.image ? (
								<ImageWrapper
									src={post.data.image}
									basePath={getFileDirFromPath(post.filePath || "")}
									alt=""
									class="h-full w-full"
								/>
							) : (
								<div class="recent-post-placeholder">
									<Icon name="material-symbols:auto-stories-outline-rounded" />
								</div>
							)}
							<span class="recent-post-number">
								{String(index + 1).padStart(2, "0")}
							</span>
						</div>
						<div class="recent-post-detail">
							<div class="recent-post-meta">
								<Icon name="material-symbols:calendar-month-outline-rounded" />
								{formatDate(post.data.updated || post.data.published)}
							</div>
							<h3>{post.data.title}</h3>
							<p>{post.data.description || "打开文章，继续阅读这篇新记录。"}</p>
							<span class="recent-post-enter">
								阅读文章
								<Icon name="material-symbols:arrow-forward-rounded" />
							</span>
						</div>
					</a>
				))}
				<div class="recent-post-progress" aria-hidden="true">
					<i></i>
				</div>
			</div>
		</recent-post-carousel>
	)
}

<script>
	class RecentPostCarousel extends HTMLElement {
		private timer?: number;
		private activeIndex = 0;
		private readonly interval = 5000;
		private remaining = this.interval;
		private startedAt = 0;
		private paused = false;

		connectedCallback() {
			this.clearTimer();
			const buttons = this.querySelectorAll<HTMLButtonElement>(
				"[data-carousel-index]",
			);
			buttons.forEach((button) => {
				button.addEventListener("click", () => {
					this.show(Number(button.dataset.carouselIndex || 0));
					this.schedule();
				});
			});
			this.addEventListener("mouseenter", this.pause);
			this.addEventListener("mouseleave", this.resume);
			this.resetProgress();
			this.schedule();
		}

		disconnectedCallback() {
			this.clearTimer();
		}

		private show(index: number) {
			const slides = this.querySelectorAll<HTMLElement>(
				"[data-carousel-slide]",
			);
			const buttons = this.querySelectorAll<HTMLButtonElement>(
				"[data-carousel-index]",
			);
			if (!slides.length) return;
			this.activeIndex = (index + slides.length) % slides.length;
			slides.forEach((slide, slideIndex) => {
				const active = slideIndex === this.activeIndex;
				slide.classList.toggle("is-active", active);
				slide.setAttribute("aria-hidden", String(!active));
			});
			buttons.forEach((button, buttonIndex) => {
				if (buttonIndex === this.activeIndex) {
					button.setAttribute("aria-current", "true");
				} else {
					button.removeAttribute("aria-current");
				}
			});
			this.remaining = this.interval;
			this.resetProgress();
		}

		private resetProgress() {
			this.classList.remove("is-ticking");
			void this.offsetWidth;
			this.classList.add("is-ticking");
			this.classList.toggle("is-paused", this.paused);
		}

		private schedule = () => {
			this.clearTimer();
			if (this.paused) return;
			const slides = this.querySelectorAll("[data-carousel-slide]");
			if (slides.length < 2) return;
			this.startedAt = performance.now();
			this.timer = window.setTimeout(() => {
				this.show(this.activeIndex + 1);
				this.schedule();
			}, this.remaining);
		};

		private pause = () => {
			if (this.paused) return;
			this.remaining = Math.max(
				0,
				this.remaining - (performance.now() - this.startedAt),
			);
			this.paused = true;
			this.clearTimer();
			this.classList.add("is-paused");
		};

		private resume = () => {
			if (!this.paused) return;
			this.paused = false;
			this.classList.remove("is-paused");
			this.schedule();
		};

		private clearTimer() {
			if (this.timer) window.clearInterval(this.timer);
			this.timer = undefined;
		}
	}

	if (!customElements.get("recent-post-carousel")) {
		customElements.define("recent-post-carousel", RecentPostCarousel);
	}
</script>

<style>
	recent-post-carousel {
		display: grid;
		grid-template-columns: minmax(15rem, 0.38fr) minmax(0, 1fr);
		min-height: 18rem;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--primary) 16%, transparent);
		border-radius: calc(var(--radius-large) + 0.35rem);
		background: color-mix(in oklch, var(--card-bg) 90%, transparent);
		box-shadow:
			0 18px 45px rgba(50, 38, 92, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.38);
		backdrop-filter: blur(18px);
	}

	.recent-posts-copy {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background:
			linear-gradient(145deg, color-mix(in oklch, var(--primary) 12%, transparent), transparent 65%),
			color-mix(in oklch, var(--card-bg) 92%, transparent);
	}

	.recent-posts-copy::after {
		content: "";
		position: absolute;
		inset: 1rem 0 1rem auto;
		width: 1px;
		background: linear-gradient(transparent, color-mix(in oklch, var(--primary) 28%, transparent), transparent);
	}

	.recent-posts-kicker {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--primary);
		font-size: 0.66rem;
		font-weight: 900;
		letter-spacing: 0.15em;
	}

	.recent-posts-kicker i {
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	.recent-posts-copy h2 {
		margin: 0.65rem 0 0.45rem;
		color: var(--deep-text);
		font-size: clamp(1.45rem, 2.3vw, 2.15rem);
		font-weight: 900;
		letter-spacing: -0.035em;
	}

	.recent-posts-copy > p {
		margin: 0;
		color: color-mix(in oklch, var(--deep-text) 55%, transparent);
		font-size: 0.82rem;
		line-height: 1.7;
	}

	.recent-posts-controls {
		display: flex;
		gap: 0.45rem;
		margin-top: 1.6rem;
	}

	.recent-posts-controls button {
		display: grid;
		width: 2.15rem;
		height: 2.15rem;
		place-items: center;
		border: 1px solid color-mix(in oklch, var(--primary) 14%, transparent);
		border-radius: 0.7rem;
		background: color-mix(in oklch, var(--card-bg) 70%, transparent);
		color: color-mix(in oklch, var(--deep-text) 52%, transparent);
		font-size: 0.65rem;
		font-weight: 800;
		transition: 180ms ease;
	}

	.recent-posts-controls button:hover,
	.recent-posts-controls button[aria-current="true"] {
		border-color: var(--primary);
		background: var(--primary);
		color: white;
		transform: translateY(-2px);
	}

	.recent-posts-stage {
		position: relative;
		min-width: 0;
		min-height: 18rem;
	}

	.recent-post-slide {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: minmax(13rem, 0.8fr) minmax(16rem, 1fr);
		gap: clamp(1rem, 2.2vw, 2rem);
		padding: 1rem;
		color: inherit;
		opacity: 0;
		pointer-events: none;
		transform: translateX(1.25rem);
		transition:
			opacity 500ms ease,
			transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.recent-post-slide.is-active {
		z-index: 1;
		opacity: 1;
		pointer-events: auto;
		transform: translateX(0);
	}

	.recent-post-cover {
		position: relative;
		min-height: 15.8rem;
		overflow: hidden;
		border-radius: calc(var(--radius-large) - 0.25rem);
		background: color-mix(in oklch, var(--primary) 12%, var(--card-bg));
	}

	.recent-post-cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.recent-post-slide:hover .recent-post-cover :global(img) {
		transform: scale(1.045);
	}

	.recent-post-cover::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 50%, rgba(20, 22, 32, 0.42));
	}

	.recent-post-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		color: color-mix(in oklch, var(--primary) 65%, transparent);
		font-size: 4rem;
	}

	.recent-post-number {
		position: absolute;
		z-index: 1;
		right: 0.85rem;
		bottom: 0.7rem;
		color: rgba(255, 255, 255, 0.9);
		font-size: 2.2rem;
		font-weight: 900;
		letter-spacing: -0.08em;
	}

	.recent-post-detail {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding-right: clamp(0.5rem, 2vw, 1.5rem);
	}

	.recent-post-meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 750;
	}

	.recent-post-meta :global(svg) {
		font-size: 1rem;
	}

	.recent-post-detail h3 {
		display: -webkit-box;
		width: 100%;
		min-width: 0;
		margin: 0.75rem 0 0.7rem;
		overflow: hidden;
		color: var(--deep-text);
		font-size: clamp(1.3rem, 2.15vw, 2rem);
		font-weight: 900;
		letter-spacing: -0.035em;
		line-height: 1.22;
		overflow-wrap: anywhere;
		word-break: break-word;
		white-space: normal;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.recent-post-detail > p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: color-mix(in oklch, var(--deep-text) 58%, transparent);
		font-size: 0.85rem;
		line-height: 1.75;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.recent-post-enter {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.35rem;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 850;
	}

	.recent-post-enter :global(svg) {
		font-size: 1.15rem;
		transition: transform 180ms ease;
	}

	.recent-post-slide:hover .recent-post-enter :global(svg) {
		transform: translateX(0.25rem);
	}

	.recent-post-progress {
		position: absolute;
		z-index: 3;
		right: 1.2rem;
		bottom: 0.65rem;
		left: calc(40% + 1.2rem);
		height: 2px;
		overflow: hidden;
		border-radius: 999px;
		background: color-mix(in oklch, var(--deep-text) 10%, transparent);
	}

	.recent-post-progress i {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		background: var(--primary);
		transform: scaleX(0);
		transform-origin: left;
	}

	recent-post-carousel.is-ticking .recent-post-progress i {
		animation: recent-progress 5s linear forwards;
	}

	recent-post-carousel.is-paused .recent-post-progress i {
		animation-play-state: paused;
	}

	@keyframes recent-progress {
		to { transform: scaleX(1); }
	}

	@media (max-width: 820px) {
		recent-post-carousel {
			grid-template-columns: 1fr;
		}

		.recent-posts-copy {
			padding: 1.25rem 1.35rem 1rem;
		}

		.recent-posts-copy::after,
		.recent-posts-copy > p {
			display: none;
		}

		.recent-posts-copy h2 {
			margin-bottom: 0;
		}

		.recent-posts-controls {
			margin-top: 1rem;
		}

		.recent-posts-stage {
			min-height: 24rem;
		}

		.recent-post-slide {
			grid-template-columns: 1fr;
			grid-template-rows: 13rem auto;
			gap: 1rem;
		}

		.recent-post-cover {
			min-height: 13rem;
		}

		.recent-post-detail {
			justify-content: flex-start;
			padding: 0 0.25rem 1.4rem;
		}

		.recent-post-detail h3 {
			margin: 0.45rem 0 0.35rem;
			font-size: 1.25rem;
			-webkit-line-clamp: 2;
		}

		.recent-post-detail > p,
		.recent-post-enter {
			display: none;
		}

		.recent-post-progress {
			left: 1.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.recent-post-slide,
		.recent-post-cover :global(img) {
			transition: none;
		}

		.recent-post-progress {
			display: none;
		}
	}
</style>
