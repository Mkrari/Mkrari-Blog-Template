---
import Profile from "@/components/widget/Profile.astro";
import { Icon } from "astro-icon/components";

type RelatedPostItem = {
	title: string;
	url: string;
	date: string;
};

interface Props {
	directoryName?: string;
	relatedPosts?: RelatedPostItem[];
}

const {
	directoryName = "相关文章",
	relatedPosts = [],
} = Astro.props;
---

<aside class="article-sidebar" aria-label="作者资料与同目录文章">
	<Profile variant="article" />
	<section class="article-related card-base" aria-labelledby="article-related-title">
		<div class="article-related-heading" id="article-related-title">
			<Icon name="material-symbols:folder-open-outline-rounded" />
			<div>
				<small>同目录文章</small>
				<strong>{directoryName}</strong>
			</div>
		</div>

		{relatedPosts.length > 0 ? (
			<nav class="article-related-list" aria-label={`${directoryName}目录文章`}>
				{
					relatedPosts.map((post, index) => (
						<a href={post.url} class="article-related-item">
							<span class="article-related-index">
								{String(index + 1).padStart(2, "0")}
							</span>
							<span class="article-related-copy">
								<strong>{post.title}</strong>
								<small>{post.date}</small>
							</span>
							<Icon name="material-symbols:chevron-right-rounded" />
						</a>
					))
				}
			</nav>
		) : (
			<p class="article-related-empty">这个目录暂时没有其他文章。</p>
		)}
	</section>
</aside>

<style is:global>
	.article-sidebar {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: 1rem;
	}

	.article-sidebar > .profile-card,
	.article-related {
		border: 1px solid color-mix(in oklch, var(--primary) 15%, transparent);
		background: var(--card-bg);
		box-shadow: 0 15px 38px rgba(47, 35, 86, 0.09);
		backdrop-filter: blur(18px);
	}

	.article-sidebar .profile-card--article {
		text-align: center;
	}

	.article-sidebar .profile-card--article .profile-avatar {
		margin-inline: auto !important;
	}

	.article-sidebar .profile-card--article .profile-links--article {
		margin: 0.55rem 0 0.75rem;
	}

	.article-sidebar .profile-card--article .profile-social-link {
		width: auto;
		gap: 0.42rem;
		padding-inline: 0.72rem;
	}

	.article-sidebar .profile-card--article .profile-bio {
		font-weight: 400;
		line-height: 1.65;
	}

	.article-related {
		position: sticky;
		top: 5.5rem;
		max-height: calc(100vh - 7rem);
		padding: 0.85rem;
		overflow: hidden;
		border-radius: var(--radius-large);
	}

	.article-related-heading {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.15rem 0.35rem 0.75rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.article-related-heading > svg {
		flex: none;
		color: var(--primary);
		font-size: 1.35rem;
	}

	.article-related-heading div {
		display: grid;
		min-width: 0;
	}

	.article-related-heading small {
		color: var(--text-secondary);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.article-related-heading strong {
		overflow: hidden;
		color: var(--deep-text);
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.95rem;
	}

	.article-related-list {
		display: grid;
		max-height: calc(100vh - 12rem);
		gap: 0.25rem;
		padding-top: 0.55rem;
		padding-right: 0.25rem;
		overflow-x: hidden;
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color:
			color-mix(in oklch, var(--primary) 58%, transparent)
			color-mix(in oklch, var(--primary) 8%, transparent);
	}

	.article-related-list::-webkit-scrollbar {
		width: 7px;
	}

	.article-related-list::-webkit-scrollbar-track {
		margin-block: 0.35rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 7%, transparent);
	}

	.article-related-list::-webkit-scrollbar-thumb {
		border: 2px solid transparent;
		border-radius: 999px;
		background:
			linear-gradient(
				180deg,
				color-mix(in oklch, var(--primary) 76%, white),
				color-mix(in oklch, var(--primary) 74%, #7dd3a7)
			)
			padding-box;
	}

	.article-related-list::-webkit-scrollbar-thumb:hover {
		background:
			linear-gradient(
				180deg,
				color-mix(in oklch, var(--primary) 88%, white),
				color-mix(in oklch, var(--primary) 86%, #55bd83)
			)
			padding-box;
	}

	.article-related-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.55rem;
		padding: 0.6rem 0.5rem;
		border-radius: 0.75rem;
		transition: background 180ms ease, transform 180ms ease;
	}

	.article-related-item:hover {
		background: var(--toc-btn-hover);
		transform: translateX(2px);
	}

	.article-related-index {
		color: var(--primary);
		font-size: 0.65rem;
		font-weight: 900;
		font-variant-numeric: tabular-nums;
	}

	.article-related-copy {
		display: grid;
		min-width: 0;
		gap: 0.15rem;
	}

	.article-related-copy strong {
		display: block;
		color: var(--deep-text);
		font-size: 0.76rem;
		line-height: 1.4;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.article-related-copy small {
		color: var(--text-secondary);
		font-size: 0.62rem;
	}

	.article-related-item > svg {
		color: var(--primary);
		font-size: 1rem;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.article-related-item:hover > svg {
		opacity: 1;
	}

	.article-related-empty {
		margin: 0;
		padding: 1rem 0.45rem 0.35rem;
		color: var(--text-secondary);
		font-size: 0.78rem;
		line-height: 1.6;
	}

	body.wallpaper-transparent .article-sidebar > .profile-card,
	body.wallpaper-transparent .article-related {
		background: var(--card-bg) !important;
	}
</style>
