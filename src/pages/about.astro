---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import PageComments from "@components/comment/PageComments.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import Markdown from "@components/misc/Markdown.astro";
import { profileConfig, siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts, getTagList } from "../utils/content-utils";

const aboutPost = await getEntry("spec", "about");
if (!aboutPost) throw new Error("About page content not found");

const { Content } = await render(aboutPost);
const title = i18n(I18nKey.about);
const posts = await getSortedPosts();
const tags = await getTagList();
const latestPost = posts
	.slice()
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())[0];
const latestDate = latestPost
	? new Intl.DateTimeFormat("zh-CN", {
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		}).format(latestPost.data.published)
	: "—";
---

<MainGridLayout title={title} hideSidebars>
	<div class="about-page">
		<section class="about-hero onload-animation">
			<div class="about-avatar-wrap">
				<div class="about-avatar-ring"></div>
				<ImageWrapper
					src={profileConfig.avatar || ""}
					alt={profileConfig.name}
					class="about-avatar"
					loading="eager"
				/>
			</div>

			<div class="about-intro">
				<span class="about-kicker">ABOUT THE AUTHOR</span>
				<h1>你好，我是 {profileConfig.name}</h1>
				<p>{profileConfig.bio}</p>
				<div class="about-links">
					{
						profileConfig.links.map((item) => (
							<a href={item.url} target="_blank" rel="me noopener noreferrer">
								<Icon name={item.icon} />
								{item.name}
								<Icon name="material-symbols:arrow-outward-rounded" />
							</a>
						))
					}
				</div>
			</div>

			<div class="about-manifesto">
				<Icon name="material-symbols:format-quote-rounded" />
				<p>把学习过程写下来，也把偶然闪过的灵感留在这里。</p>
				<span>MKRARI'S LOG</span>
			</div>
		</section>

		<section class="about-stats" aria-label="博客概览">
			<div>
				<Icon name="material-symbols:article-outline-rounded" />
				<span>文章</span>
				<strong>{posts.length}</strong>
			</div>
			<div>
				<Icon name="material-symbols:folder-outline-rounded" />
				<span>主题</span>
				<strong>{tags.length}</strong>
			</div>
			<div>
				<Icon name="material-symbols:calendar-month-outline-rounded" />
				<span>启程</span>
				<strong>{siteConfig.siteStartDate?.slice(0, 4) || "2026"}</strong>
			</div>
			<div>
				<Icon name="material-symbols:update-rounded" />
				<span>最近更新</span>
				<strong>{latestDate}</strong>
			</div>
		</section>

		<section class="about-content-grid">
			<article class="about-story onload-animation">
				<div class="about-section-title">
					<span>01</span>
					<div>
						<small>PROFILE</small>
						<h2>关于我</h2>
					</div>
				</div>
				<Markdown class="about-markdown">
					<Content />
				</Markdown>
			</article>

			<aside class="about-now onload-animation">
				<div class="about-section-title">
					<span>02</span>
					<div>
						<small>NOW</small>
						<h2>正在进行</h2>
					</div>
				</div>
				<ul>
					<li>
						<Icon name="material-symbols:security-rounded" />
						<div><strong>网络安全</strong><span>持续学习与实践</span></div>
					</li>
					<li>
						<Icon name="material-symbols:code-blocks-rounded" />
						<div><strong>竞赛与算法</strong><span>记录解题思路</span></div>
					</li>
					<li>
						<Icon name="material-symbols:edit-note-rounded" />
						<div><strong>技术写作</strong><span>把知识沉淀成文章</span></div>
					</li>
				</ul>
			</aside>
		</section>

		<PageComments
			path="/about"
			title="和我聊聊"
			description="如果你对这些经历或文章感兴趣，欢迎在这里留下想法。"
		/>
	</div>
</MainGridLayout>

<style is:global>
	.about-page {
		--about-border: color-mix(in oklch, var(--primary) 16%, transparent);
		display: flex;
		max-width: 1120px;
		flex-direction: column;
		gap: 1rem;
		margin: 0 auto;
		padding-bottom: 1rem;
	}

	.about-hero,
	.about-stats,
	.about-story,
	.about-now {
		border: 1px solid var(--about-border);
		background: var(--card-bg);
		box-shadow: 0 18px 48px rgba(48, 35, 88, 0.1);
	}

	.about-hero {
		position: relative;
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr) minmax(15rem, 0.55fr);
		align-items: center;
		gap: 2rem;
		min-height: 21rem;
		padding: clamp(1.5rem, 4vw, 3.25rem);
		overflow: hidden;
		border-radius: calc(var(--radius-large) + 0.45rem);
		background:
			radial-gradient(circle at 88% 16%, color-mix(in oklch, var(--primary) 20%, transparent), transparent 35%),
			var(--card-bg);
	}

	.about-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(color-mix(in oklch, var(--primary) 6%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in oklch, var(--primary) 6%, transparent) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: linear-gradient(90deg, black, transparent 75%);
	}

	.about-hero > * {
		position: relative;
		z-index: 1;
	}

	.about-avatar-wrap {
		position: relative;
		width: 10rem;
		height: 10rem;
	}

	.about-avatar {
		width: 9rem;
		height: 9rem;
		margin: 0.5rem;
		border-radius: 2rem;
		box-shadow: 0 16px 38px rgba(43, 29, 82, 0.2);
		transform: rotate(-2deg);
	}

	.about-avatar img {
		object-fit: cover;
	}

	.about-avatar-ring {
		position: absolute;
		inset: 0;
		border: 1px dashed color-mix(in oklch, var(--primary) 55%, transparent);
		border-radius: 2.35rem;
		transform: rotate(6deg);
	}

	.about-kicker {
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.18em;
	}

	.about-intro h1 {
		margin: 0.35rem 0 0;
		color: var(--deep-text);
		font-size: clamp(2rem, 4vw, 3.35rem);
		font-weight: 900;
		letter-spacing: -0.055em;
		line-height: 1.08;
	}

	.about-intro > p {
		margin: 0.8rem 0 0;
		color: var(--deep-text);
		font-weight: 400;
	}

	.about-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.about-links a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.68rem 0.85rem;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, transparent);
		border-radius: 0.8rem;
		background: color-mix(in oklch, var(--primary) 8%, var(--card-bg));
		color: var(--primary);
		font-size: 0.75rem;
		font-weight: 800;
		transition: transform 180ms ease, background 180ms ease;
	}

	.about-links a:hover {
		transform: translateY(-3px);
		background: color-mix(in oklch, var(--primary) 14%, var(--card-bg));
	}

	.about-links svg:last-child {
		font-size: 0.95rem;
	}

	.about-manifesto {
		padding: 1.2rem;
		border-left: 1px dashed color-mix(in oklch, var(--primary) 28%, transparent);
	}

	.about-manifesto > svg {
		color: var(--primary);
		font-size: 2rem;
	}

	.about-manifesto p {
		margin: 0.35rem 0 0.75rem;
		color: color-mix(in oklch, var(--deep-text) 70%, transparent);
		font-family: serif;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.65;
	}

	.about-manifesto span {
		color: var(--primary);
		font-size: 0.55rem;
		font-weight: 900;
		letter-spacing: 0.15em;
	}

	.about-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		overflow: hidden;
		border-radius: calc(var(--radius-large) + 0.15rem);
	}

	.about-stats > div {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.15rem 0.7rem;
		padding: 1rem 1.2rem;
		border-right: 1px dashed var(--about-border);
	}

	.about-stats > div:last-child {
		border-right: 0;
	}

	.about-stats svg {
		grid-row: 1 / 3;
		color: var(--primary);
		font-size: 1.65rem;
	}

	.about-stats span {
		color: color-mix(in oklch, var(--deep-text) 42%, transparent);
		font-size: 0.65rem;
	}

	.about-stats strong {
		color: var(--deep-text);
		font-size: 1rem;
	}

	.about-content-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
		gap: 1rem;
	}

	.about-story,
	.about-now {
		padding: clamp(1.4rem, 3vw, 2.25rem);
		border-radius: calc(var(--radius-large) + 0.25rem);
	}

	.about-section-title {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 1.25rem;
	}

	.about-section-title > span {
		display: grid;
		width: 2.6rem;
		height: 2.6rem;
		place-items: center;
		border-radius: 0.8rem;
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		color: var(--primary);
		font-size: 0.7rem;
		font-weight: 900;
	}

	.about-section-title small {
		color: var(--primary);
		font-size: 0.55rem;
		font-weight: 900;
		letter-spacing: 0.14em;
	}

	.about-section-title h2 {
		margin: 0;
		color: var(--deep-text);
		font-size: 1.35rem;
		font-weight: 900;
	}

	.about-markdown h1 {
		font-size: 1.25rem !important;
	}

	.about-markdown h2 {
		font-size: 1rem !important;
	}

	.about-now ul {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.about-now li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.8rem;
		border-radius: 0.8rem;
		background: color-mix(in oklch, var(--primary) 6%, var(--card-bg));
	}

	.about-now li > svg {
		flex: none;
		color: var(--primary);
		font-size: 1.45rem;
	}

	.about-now li strong,
	.about-now li span {
		display: block;
	}

	.about-now li strong {
		color: var(--deep-text);
		font-size: 0.8rem;
	}

	.about-now li span {
		margin-top: 0.15rem;
		color: color-mix(in oklch, var(--deep-text) 45%, transparent);
		font-size: 0.68rem;
	}

	body.wallpaper-transparent .about-hero,
	body.wallpaper-transparent .about-stats,
	body.wallpaper-transparent .about-story,
	body.wallpaper-transparent .about-now {
		background: var(--card-bg) !important;
		backdrop-filter: blur(18px);
	}

	@media (max-width: 850px) {
		.about-hero {
			grid-template-columns: 8rem minmax(0, 1fr);
			min-height: 0;
		}

		.about-avatar-wrap {
			width: 8rem;
			height: 8rem;
		}

		.about-avatar {
			width: 7rem;
			height: 7rem;
		}

		.about-manifesto {
			grid-column: 1 / -1;
			border-top: 1px dashed var(--about-border);
			border-left: 0;
		}

		.about-content-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.about-hero {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 1.2rem;
			padding: 1.35rem;
		}

		.about-avatar-wrap {
			width: 6.5rem;
			height: 6.5rem;
		}

		.about-avatar {
			width: 5.8rem;
			height: 5.8rem;
			border-radius: 1.4rem;
		}

		.about-intro h1 {
			font-size: 2rem;
		}

		.about-manifesto {
			padding: 1rem 0 0;
		}

		.about-stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.about-stats > div {
			border-bottom: 1px dashed var(--about-border);
		}

		.about-stats > div:nth-child(2) {
			border-right: 0;
		}
	}
</style>
